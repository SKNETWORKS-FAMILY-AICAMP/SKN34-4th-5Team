    },
    "source_identity": {
      "mode": "provider_evidence_and_manual",
      "rule": "장소 ID·이름·좌표·URL의 지점 동일성을 대조한다. 검색 결과 존재만으로 메뉴·영업·시설 충족을 인정하지 않는다."
    },
    "menu": {
      "mode": "provider_evidence_and_manual",
      "rule": "명시 메뉴의 실제 제공 근거와 지점 동일성을 확인한다. 매장명/업종 단어만으로 메뉴 충족을 인정하지 않는다. 자장면/짜장면, 돈카츠/돈까스는 동의어다."
    },
    "brand": {
      "mode": "payload_and_provider_evidence",
      "rule": "지정 브랜드의 실제 지점을 확인한다. 다른 저가 브랜드로 대체하면 실패다."
    },
    "internal": {
      "mode": "catalog_and_payload",
      "rule": "해당 방문에 내부 요청이 있을 때만 자리어때 수집 매장을 쓴다. 사이트의 외부 표시 매장도 수집 목록이면 허용한다. 상세 위치 URL과 매장 ID를 대조하고 카카오 내부 후보로 대체하지 않는다."
    },
    "bar_rating": {
      "mode": "provider_evidence_and_manual",
      "rule": "외부 술집은 실제 술집 업종과 동일 지점의 유효 평점·평가 1건 이상 근거가 필요하다. 미확인·0건은 통과시키지 않는다. 내부 매장에는 적용하지 않는다."
    },
    "timeline": {
      "mode": "payload",
      "rule": "일반 구장 도착은 경기 20분 전, 직전 내부 먹거리는 30분 전부터 경기로 연결한다. 명시 시간 우선, 체류·이동·날짜 넘김을 반영한다. 경기 종료 예상값은 확정 사실이 아니다."
    },
    "availability": {
      "mode": "provider_evidence_and_payload",
      "rule": "방문 날짜·시각에 적용되는 확인된 휴무/브레이크타임을 반영한다. 휴무라는 단어만으로 전체 휴무로 판정하지 않는다. 정보 부족은 미확인이다."
    },
    "preserve": {
      "mode": "before_after_payload",
      "rule": "대상 외 장소 ID·이름·좌표·visitId·순서·종류·체류·고정/완료 상태, 경기 날짜·시각·가상 표식과 출발지를 보존한다. 이동 변화에 따른 time/until/legMin은 재계산할 수 있다."
    },
    "hotel": {
      "mode": "provider_evidence_and_manual",
      "rule": "NOL 상세 원문의 이름·주소·유형·명시 조건을 각각 대조한다. 미확인 조건을 성공 처리하거나 예약 가능·가격을 임의 생성하지 않는다."
    },
    "no_extra_model": {
      "mode": "trace_review",
      "rule": "모델 호출 수를 수집해 비교한다. 특정 횟수를 새 강제 합격 상한으로 정하지 않는다. 이동·일정 조건을 모든 매장 속성으로 반복 검증하면 원인을 기록한다.",
      "affects_task_completion": false
    },
    "saved": {
      "mode": "api_and_storage",
      "rule": "최종 course payload와 시험 세션 저장 결과가 일치한다. API 성공은 지도 표시 성공과 별도이다."
