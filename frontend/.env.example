# Kakao Developers > App > JavaScript key.
# Register http://localhost:3000 as a JavaScript SDK domain.
# Copy to .env.local. Only the JavaScript key goes in this public variable.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Development-only member UI preview; never authenticates backend requests.
NEXT_PUBLIC_MEMBER_PREVIEW=false

# Server-only canonical browser origin when Docker/proxies use an internal URL.
# Exact scheme://host:port only: no trailing slash, path, wildcard or credentials.
# Auth workspace example: http://127.0.0.1:3100 (use that hostname in the browser).
# Leave unset for direct hosting where request.url already has the public origin.
APP_ORIGIN=

# Server-only cookie policy for legacy Next routes that still proxy chat/admin.
# Leave unset for the existing NODE_ENV default; set false only on explicit HTTP deployments.
AUTH_COOKIE_SECURE=
